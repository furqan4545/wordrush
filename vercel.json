{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {"source": "/press-events/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path"},
    {"source": "/press-events/array/:path(.*)", "destination": "https://us-assets.i.posthog.com/array/:path"},
    {"source": "/press-events/:path(.*)", "destination": "https://us.i.posthog.com/:path"}
  ],
  "headers": [
    {"source": "/templates/v1/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
